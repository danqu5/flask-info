{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ComputeNetworkLoadBalancerRegistry",
      "Effect": "Allow",
      "Action": [
        "ec2:*",
        "elasticloadbalancing:*",
        "ecr:*",
        "sts:GetCallerIdentity"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ProjectIamOnly",
      "Effect": "Allow",
      "Action": "iam:*",
      "Resource": [
        "arn:aws:iam::*:role/flask-info-*",
        "arn:aws:iam::*:instance-profile/flask-info-*",
        "arn:aws:iam::*:user/flask-info-*"
      ]
    },
    {
      "Sid": "AllowLoadBalancerServiceLinkedRole",
      "Effect": "Allow",
      "Action": "iam:CreateServiceLinkedRole",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "iam:AWSServiceName": "elasticloadbalancing.amazonaws.com"
        }
      }
    }
  ]
}
